{
  "expo": {
    "name": "Giftory",
    "slug": "giftory-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "giftory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.giftory.mobile"
    },
    "android": {
      "package": "com.giftory.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
