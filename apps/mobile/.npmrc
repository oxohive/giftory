# A plain `npm install` (npm 11) fails here with ERESOLVE on an *optional* peer
# (@vinejs/vine, declared by @hookform/resolvers@5.9.x) that this app never
# uses. Resolve peers the npm 6 way so the documented `npm install` works on a
# clean checkout. Remove once the dependency tree installs without it.
legacy-peer-deps=true
