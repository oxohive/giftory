# ---------------------------------------------------------------------------
# Public (shipped to the browser). Never put secrets in NEXT_PUBLIC_* keys.
# ---------------------------------------------------------------------------
# Open Mercato backend origin. Also used server-side unless MERCATO_INTERNAL_API_BASE_URL is set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Stripe publishable key (pk_test_...). The backend also returns it with each payment session;
# this is the fallback used when the session payload omits it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Razorpay key id (rzp_test_...). Fallback when the payment session payload omits keyId.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Public site origin (canonical URLs, Stripe return_url).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Server-only (read by route handlers / server components; never bundled for the client).
# ---------------------------------------------------------------------------
# Optional internal URL for server-to-server calls (e.g. http://mercato:3000 inside Docker).
MERCATO_INTERNAL_API_BASE_URL=
# Tenant + organization that own the storefront. Customer login/signup on a "platform domain"
# (PLATFORM_DOMAINS on the backend, default localhost) must send organizationId (tenant is derived
# from it). The BFF proxy injects these into login/signup bodies.
MERCATO_TENANT_ID=
MERCATO_ORGANIZATION_ID=
# Organization slug: used to resolve the shop when MERCATO_ORGANIZATION_ID is empty.
MERCATO_ORGANIZATION_SLUG=
# Optional sales channel id used to resolve channel-specific catalog prices.
MERCATO_SALES_CHANNEL_ID=
# No API key is needed: catalog reads use the public `/api/storefront/catalog/*` routes, and the
# shop is resolved from MERCATO_ORGANIZATION_ID (or MERCATO_ORGANIZATION_SLUG).
