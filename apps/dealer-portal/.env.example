# Server-only: base URL of the apps/mercato backend. Only read by the BFF proxy
# (src/app/api/om/[...path]/route.ts) — never exposed to the browser.
OM_API_BASE_URL=http://localhost:3000

# Reserved for a future tenant-pinned registration flow (dealer_onboarding's public
# register endpoint currently takes a caller-chosen organizationId; see
